#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.."

swift_files=()
while IFS= read -r file; do
    swift_files+=("$file")
done < <(git ls-files --cached --others --exclude-standard '*.swift')

if [ "${1:-}" = "--fix" ]; then
    swift format format --in-place "${swift_files[@]}"
    swiftlint lint --fix --quiet
fi

status=0
swift format lint --strict "${swift_files[@]}" || status=1
swiftlint lint --strict --quiet || status=1
exit "$status"
