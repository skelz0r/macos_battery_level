#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.."

usage() {
    echo "Usage: bin/release [--dry-run] <version>" >&2
    exit 1
}

dry_run=false
if [ "${1:-}" = "--dry-run" ]; then
    dry_run=true
    shift
fi
[ $# -eq 1 ] || usage
version="$1"
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || usage
tag="v$version"

fail() {
    echo "$1" >&2
    exit 1
}

identity="${DEVELOPER_ID:-$(security find-identity -v -p codesigning \
    | sed -n 's/.*"\(Developer ID Application: .*\)"/\1/p' | head -n 1)}"
[ -n "$identity" ] || fail "No Developer ID Application certificate in the keychain."

if [ "$dry_run" = false ]; then
    [ -z "$(git status --porcelain)" ] || fail "The working tree is not clean."
    ! git rev-parse -q --verify "refs/tags/$tag" > /dev/null || fail "Tag $tag already exists."
    : "${ASC_KEY_ID:?ASC_KEY_ID is not set}"
    : "${ASC_KEY_ISSUER_ID:?ASC_KEY_ISSUER_ID is not set}"
    : "${ASC_KEY_PATH:?ASC_KEY_PATH is not set}"
fi

VERSION="$version" SIGN_IDENTITY="$identity" ./build.sh
codesign --verify --strict --deep BatteryTime.app

dmg="dist/BatteryTime-$version.dmg"
staging="$(mktemp -d)"
trap 'rm -rf "$staging"' EXIT
cp -R BatteryTime.app "$staging/"
ln -s /Applications "$staging/Applications"
mkdir -p dist
rm -f "$dmg"
hdiutil create -volname BatteryTime -srcfolder "$staging" -format UDZO -quiet "$dmg"
codesign --sign "$identity" --timestamp "$dmg"
codesign --verify --strict "$dmg"

if [ "$dry_run" = true ]; then
    echo "Built and signed $dmg, not notarized nor published."
    exit 0
fi

xcrun notarytool submit "$dmg" \
    --key "$ASC_KEY_PATH" --key-id "$ASC_KEY_ID" --issuer "$ASC_KEY_ISSUER_ID" \
    --wait
xcrun stapler staple "$dmg"
spctl --assess --type open --context context:primary-signature --verbose "$dmg"

git tag "$tag"
git push origin "$tag"
gh release create "$tag" "$dmg" --verify-tag --title "BatteryTime $version" --generate-notes

echo "Released $tag."
